# ==============================================================================
# JM VERTEX HACKATHON 2027 · CONFIGURATION ENVIRONMENT
# Edit values below to customize event pricing, dates, location, credentials, etc.
# ==============================================================================

# Application Environment (development | production)
APP_ENV=development
SECRET_KEY=hackathon-dev-secret-key-replace-in-prod-8f13-41dd
HOST=127.0.0.1
PORT=8000

# Event Identity & Details
EVENT_NAME="JM Vertex Hackathon 2027"
TAGLINE="Turn a real-world problem into a working prototype in 24 hours."
ORGANISER="JM Vertex Technologies"
EVENT_LOCATION="Pollachi, Tamil Nadu"
VENUE="JM Vertex Innovation Hub, Pollachi, Tamil Nadu"

# Pricing & Capacity (Changes update everywhere in real-time)
REGISTRATION_FEE_PER_MEMBER_INR=99
MIN_TEAM_MEMBERS=2
MAX_TEAM_MEMBERS=5

# Critical Event Timeline (ISO 8601 YYYY-MM-DDTHH:MM:SS)
REGISTRATION_OPEN_DATE=2026-10-30T00:00:00
REGISTRATION_DEADLINE=2026-12-20T23:59:59
HACKATHON_START_DATE=2027-01-07T09:00:00
HACKATHON_END_DATE=2027-01-08T09:00:00

# Support & Contact
CONTACT_EMAIL=support@jmvertex.com
CONTACT_PHONE=+91 98765 43210

# Google Drive Storage Integration
# Paste the Google Drive folder link or folder ID where uploaded presentations will be directed
GOOGLE_DRIVE_FOLDER_URL=https://drive.google.com/drive/folders/your-folder-id
GOOGLE_DRIVE_FOLDER_ID=your-folder-id
# Optional: Service Account JSON for direct Google Drive API uploads
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# Admin Dashboard Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminPass@2027!

# Razorpay Payment Gateway (Live or Test mode)
# Required for registration payments. Set both values in your deployment environment.
RAZORPAY_KEY_ID=rzp_test_TpPQr714llyXQ7
RAZORPAY_KEY_SECRET=fElaFYdl7Kmi3fMKrPgbze6l

# Supabase Database & Storage (Optional: defaults to local SQLite fallback if empty)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=hackathon-ideas

# Vercel deployment: add all Supabase and Razorpay values above in the Vercel
# project environment settings. Supabase is required for persistent data because
# Vercel's local /tmp storage is cleared between serverless function instances.

# Developer only flag (bypasses date gate check in development)
FORCE_UNLOCK_REGISTRATION=false
