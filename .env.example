# --- App ---
APP_ENV=development            # set to "production" on Render
SECRET_KEY=change-me-to-a-long-random-value
HOST=127.0.0.1
PORT=8000

# --- Admin (no defaults in code) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- Razorpay (test keys only during development) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- Supabase (service-role key is server-side only, never in frontend code) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=hackathon-ideas

# --- Event rules ---
REGISTRATION_FEE_INR=500
MIN_TEAM_MEMBERS=4
MAX_TEAM_MEMBERS=6
# Dates without an offset are read as IST (Asia/Kolkata)
REGISTRATION_OPEN_DATE=2026-10-30T00:00:00
REGISTRATION_DEADLINE=2026-12-20T23:59:59
HACKATHON_START_DATE=2027-01-07T09:00:00
HACKATHON_END_DATE=2027-01-08T09:00:00
FORCE_UNLOCK_REGISTRATION=false   # developer-only; ignored when APP_ENV=production

# --- Organiser contact shown on the landing page ---
CONTACT_EMAIL=contact@example.com
CONTACT_PHONE=+91 00000 00000
